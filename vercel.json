{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/handler?path=:path*" },
    { "source": "/g/:id", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] }
  ]
}
